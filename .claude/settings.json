{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes --package=@kumiq-app/hooks@0.1.3 kumiq run --agent claude"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "get_standards|list_workflow_skills|get_workflow_skill",
        "hooks": [
          {
            "type": "command",
            "command": "node /absolute/path/to/this/repo/dist/hooks/workflow-gate.js"
          }
        ]
      }
    ]
  }
}
